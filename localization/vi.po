msgstr "Cặn tro chắn đường. Dọn sạch rồi mình đi tiếp."

msgid "BARK_CH01_WAVE1_NEO"
msgstr "Cặn tro chắn đường phía trước. Dọn sạch rồi đi tiếp nhé."

msgid "BARK_CH01_CP1"
