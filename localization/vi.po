msgid "NEO_HINT_REACTION"
msgstr "Phản ứng nguyên tố! Đổi người đúng lúc là vậy đó, Quản lý."

msgid "STORY_CH01_OPEN_SUMMARY"
msgstr "Lửa Lò Mẹ tắt dần, còn Golem Đá Cổ thức dậy chắn cửa lò. Xuyên qua thung lũng, vượt qua thủ vệ và tìm ra vì sao lửa tắt trước khi quá muộn."

msgid "STORY_CH01_OPEN_01_1"
msgstr "Thung Lũng Tro Tàn."

msgid "STORY_CH01_OPEN_02_1"
msgstr "Tới rồi! …Ơ. Sao im thế này?"

msgid "STORY_CH01_OPEN_03_1"
msgstr "Không có gió. Tro rơi thẳng xuống như rơi trong nhà kín."

msgid "STORY_CH01_OPEN_04_1"
msgstr "Lò Mẹ ở cuối đường này."

msgid "STORY_CH01_OPEN_05_1"
msgstr "Đây là quê cậu à? Hồi ở Lò Nanh cậu kể suốt."

msgid "STORY_CH01_OPEN_06_1"
msgstr "Ừ. Lửa ở đây từng cao hơn mái nhà. Giờ thì… cậu nhìn đi."

msgid "STORY_CH01_OPEN_07_1"
msgstr "Phát hiện ranh giới Vùng Thực. Mật độ nguyên tố phía trước chỉ còn 12%."

msgid "STORY_CH01_OPEN_08_1"
msgstr "Đủ nuôi một bộ giáp. Không đủ cho ba."

msgid "STORY_CH01_OPEN_08_2"
msgstr "Vậy là đúng như bản hướng dẫn nói hả? Tớ… đọc lướt thôi."

msgid "STORY_CH01_OPEN_09_1"
msgstr "Một người ra sân, hai người chờ trong kênh của Neo. Quản lý quyết định ai ra."

msgid "STORY_CH01_OPEN_09_2"
msgstr "Khi kênh của ai đó cộng hưởng, tôi sẽ báo. Đổi đúng lúc ấy, hai nguyên tố sẽ chạm nhau."

msgid "STORY_CH01_OPEN_09_3"
msgstr "Rồi nổ chứ gì! Phần đó thì tớ nhớ."

msgid "STORY_CH01_OPEN_10_1"
msgstr "Tín hiệu lớn ở cuối thung lũng. Một thủ vệ đá… nó đang đứng chắn cửa Lò Mẹ."

msgid "STORY_CH01_OPEN_10_2"
msgstr "Golem Đá Cổ…? Nó canh Lò Mẹ cả trăm năm, chưa từng nhúc nhích."

msgid "STORY_CH01_OPEN_11_1"
msgstr "Lửa không tự tắt nhanh vậy đâu. Có ai đó đang dập nó."

msgid "STORY_CH01_OPEN_12_1"
msgstr "Còn mấy cục tro biết nhảy kia là gì?"

msgid "STORY_CH01_OPEN_12_2"
msgstr "Cặn. Nguyên tố thừa vón lại. Chúng bị kéo về phía lò, chắn hết đường."

msgid "STORY_CH01_OPEN_13_1"
msgstr "Quản lý. Lò Mẹ mà tắt hẳn thì Vùng Thực nuốt luôn làng tớ. Cho bọn tớ vào."

msgid "STORY_CH01_OPEN_14_1"
msgstr "Đã ghi mục tiêu. Chờ lệnh xuất kích của Quản lý."

msgid "STORY_CH01_OPEN_15_1"
msgstr "Cần chạy nhanh thì gọi tớ."

msgid "STORY_CH01_OPEN_15_2"
msgstr "Còn tớ nhắc trước: đừng để bị đánh trúng nhiều quá."

msgid "STORY_CH01_OPEN_CARD_TITLE"
msgstr "Chương 1 — Thung Lũng Tro Tàn"

msgid "STORY_CH01_OPEN_CARD_SUB"
msgstr "Mục tiêu: xuyên qua thung lũng, vượt qua Golem Đá Cổ đang chắn cửa Lò Mẹ."

msgid "STORY_CH01_END_SUMMARY"
msgstr "Kẻ đeo mặt nạ bị đánh bại và bị rút về một kênh lạ. Lò Mẹ cháy lại, làng an toàn. Hai mảnh ấn mã 00 cho thấy hắn chỉ là tay sai của một Quản lý khác, dưới trướng thủ lĩnh mã 00. Manh mối dẫn tới Cao nguyên Thủ Vệ."

msgid "STORY_CH01_END_01_1"
msgstr "Giáp của hắn đã vỡ. Vùng Thực loãng rồi: mọi người ra được."

msgid "STORY_CH01_END_02_1"
msgstr "Phù… Tên này còn lì hơn cả con golem."

msgid "STORY_CH01_END_03_1"
msgstr "Thắng một tay sai thì đã sao. Quản lý của ta chỉ cần lò này tắt một đêm."

msgid "STORY_CH01_END_04_1"
msgstr "Đứng lại!"

msgid "STORY_CH01_END_04_2"
msgstr "Hắn bị rút về một kênh khác. Định dạng… 00."

msgid "STORY_CH01_END_05_1"
msgstr "Dậy đi. Tới lượt cậu rồi."

msgid "STORY_CH01_END_06_1"
msgstr "…Cháy rồi."

msgid "STORY_CH01_END_06_2"
msgstr "Cháy rồi! Cháy thật rồi!"

msgid "STORY_CH01_END_07_1"
msgstr "Gió cũng về rồi. Nghe này."

msgid "STORY_CH01_END_07_2"
msgstr "Ranh giới Vùng Thực đã lùi 2 km. Làng Lò Than an toàn rồi."

msgid "STORY_CH01_END_08_1"
msgstr "Hắn làm rơi cái này. Giống hệt cái trong golem."

msgid "STORY_CH01_END_09_1"
msgstr "Cả hai cùng nguồn lệnh 00. Golem và tên đó nhận lệnh từ cùng một mạng kênh."

msgid "STORY_CH01_END_09_2"
msgstr "Tay sai, rồi Quản lý của hắn, rồi kẻ mang mã 00…"

msgid "STORY_CH01_END_10_1"
msgstr "Tớ sẽ lần ra từng người một. Không ai được dập lửa của làng tớ nữa."

msgid "STORY_CH01_END_11_1"
msgstr "Dấu này tớ từng thấy trên bản đồ. Xưởng làm thủ vệ trên cao nguyên đá."

msgid "STORY_CH01_END_11_2"
msgstr "Muốn sai được thủ vệ thì chắc chúng đã ghé đó trước."

msgid "STORY_CH01_END_12_1"
msgstr "Đi luôn hả? Chân tớ vẫn còn nóng."

msgid "STORY_CH01_END_13_1"
msgstr "Đi. Lò Mẹ cháy lại rồi. Tớ không để nơi nào khác tắt như vậy nữa."

msgid "STORY_CH01_END_13_2"
msgstr "Đã ghi tọa độ: Cao nguyên Thủ Vệ. Chờ lệnh của Quản lý."

msgid "STORY_CH01_END_14_1"
msgstr "Tay sai thua rồi à. Không sao. Báo với 00: thủ vệ trên cao nguyên còn nhiều."

