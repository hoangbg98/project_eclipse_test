msgid "STAGE_01_02_NAME"
msgstr "Làng Lò Than"

msgid "STAGE_01_02_DESC"
msgstr "Lò Mẹ vẫn lạnh, Cặn tro tràn xuống làng. Dấu kênh lạ của kẻ đeo mặt nạ cũng đi qua đây. Dọn sạch lối và giữ cổng làng Lò Than."

msgid "ENEMY_SLIME_02"
msgstr "Slime tro lớn"

msgid "BARK_CH01_2_START"
msgstr "Dấu kênh lạ đi về phía làng. Cặn tro cũng đang tràn xuống."

msgid "BARK_CH01_2_WAVE1"
msgstr "Không để con nào tới được làng!"

msgid "BARK_CH01_2_WAVE1_NEO"
msgstr "Cặn tro chặn đường. Dọn sạch rồi đi tiếp."

msgid "BARK_CH01_2_WAVE2"
msgstr "Con to kia là Cặn kết khối. Cắn chậm mà nặng, né rồi đánh trả."

msgid "BARK_CH01_2_WAVE2_NEO"
msgstr "Cặn tro kết khối. Đòn chậm nhưng nặng, né rồi phản công."

msgid "BARK_CH01_2_CP2"
msgstr "Thấy mái làng rồi! Có khói bếp, vẫn còn người ở đó."

msgid "BARK_CH01_2_CP2_NEO"
msgstr "Làng Lò Than ở phía trước."

msgid "BARK_CH01_2_WAVE3"
msgstr "Đàn cuối ở ngay cổng làng. Dồn hết sức!"

msgid "BARK_CH01_2_CLEAR"
msgstr "Làng tạm ổn rồi. Giờ tìm kẻ đã sai golem."

msgid "BARK_CH01_2_CLEAR_NEO"
msgstr "Cổng làng an toàn. Tiến tới cổng để hoàn tất."

msgid "STAGE_01_03_NAME"
msgstr "Hầm Than Ngầm"

msgid "STAGE_01_03_DESC"
msgstr "Dấu kênh lạ dẫn xuống hầm than cũ dưới làng, nơi mạch lửa ngầm nuôi Lò Mẹ. Có kẻ đã lấp mạch lửa. Xuống hầm, phá ổ Cặn chắn đường."

msgid "BARK_CH01_3_START"
msgstr "Nhiệt dưới lòng đất đang tụt. Dấu kênh lạ đi xuống chính hầm này."

msgid "BARK_CH01_3_WAVE1"
msgstr "Tối om thế này mà chúng vẫn tìm ra tụi mình à?!"

msgid "BARK_CH01_3_WAVE1_NEO"
msgstr "Cặn tro phía trước. Chúng bám theo hơi ấm."

msgid "BARK_CH01_3_CP1"
msgstr "Mạch lửa bị lấp bằng đá mới. Có kẻ cố ý làm vậy."

msgid "BARK_CH01_3_CP1_NEO"
msgstr "Mạch lửa ngầm bị lấp. Dấu vết còn mới."

msgid "BARK_CH01_3_WAVE2"
msgstr "Có gió lùa từ sâu bên trong. Cặn đang kéo theo nó."

msgid "BARK_CH01_3_WAVE2_NEO"
msgstr "Hai khối Cặn lớn. Né đòn cắn rồi phản công."

msgid "BARK_CH01_3_CP2"
msgstr "Dấu ba vòng đá… giống hệt trên lưng golem. Thủ vệ đã đào hầm này."

msgid "BARK_CH01_3_CP2_NEO"
msgstr "Dấu khắc ba vòng đá, trùng với dấu trên lưng golem."

msgid "BARK_CH01_3_WAVE3"
msgstr "Ổ Cặn ở cuối hầm, ngay chỗ mạch lửa bị lấp."

msgid "BARK_CH01_3_CLEAR"
msgstr "Mạch lửa thông rồi, mà Lò Mẹ vẫn chưa cháy. Hắn còn làm gì nữa?"

msgid "BARK_CH01_3_CLEAR_NEO"
msgstr "Ổ Cặn đã tan. Ra cửa hầm để hoàn tất."

msgid "STAGE_01_04_NAME"
msgstr "Vách Lò Mẹ"

msgid "STAGE_01_04_DESC"
msgstr "Ống thông khí trên vách Lò Mẹ bị lấp cố ý nên lò không thở được. Leo đường vách hẹp, dọn đàn Cặn và lần theo kẻ đã lấp ống."

msgid "BARK_CH01_4_START"
msgstr "Ống thông khí trên vách bị lấp. Lò không thở được thì không cháy nổi."

msgid "BARK_CH01_4_WAVE1"
msgstr "Không có gió… mà ống lại bị lấp kín. Chuyện này không tự nhiên."

msgid "BARK_CH01_4_WAVE1_NEO"
msgstr "Cặn tro bị hơi nóng của lò hút tới."

msgid "BARK_CH01_4_CP1"
msgstr "Cao thế này mà rơi thì… thôi, khỏi nghĩ."

msgid "BARK_CH01_4_CP1_NEO"
msgstr "Đường vách hẹp. Cẩn thận chỗ sụt."

msgid "BARK_CH01_4_WAVE2"
msgstr "Cặn lớn bám quanh miệng ống thông khí. Dọn sạch để lò thở."

msgid "BARK_CH01_4_CP2"
msgstr "Dấu chân trên gờ đá, còn mới. Hắn vừa đi qua."

msgid "BARK_CH01_4_CP2_NEO"
msgstr "Phát hiện dấu vết mới trên gờ đá."

msgid "BARK_CH01_4_WAVE3"
msgstr "Đỉnh vách rồi! Dọn nốt đám này là xong!"

msgid "BARK_CH01_4_WAVE3_NEO"
msgstr "Ống thông khí cuối cùng. Dọn sạch đàn Cặn."

msgid "BARK_CH01_4_CLEAR"
msgstr "Ống thông rồi. Nhưng dấu chân hắn chạy lên cao hơn nữa."

msgid "BARK_CH01_4_CLEAR_NEO"
msgstr "Mọi ống thông khí đã thông. Lên đỉnh vách để hoàn tất."

msgid "STORY_CH01_GOLEM_SUMMARY"
msgstr "Golem đổ, nhưng Lò Mẹ vẫn lạnh: thủ vệ chỉ bị sai tới chặn đường. Trong đá vỡ có mảnh ấn kênh mã 00, và một kẻ đeo mặt nạ đứng nhìn từ trên vách rồi bỏ đi. Kẻ dập lửa thật vẫn ở trong thung lũng."

msgid "STORY_CH01_GOLEM_01_1"
msgstr "Thủ vệ đã ngừng hoạt động. Mở kênh: mọi người ra được rồi."

msgid "STORY_CH01_GOLEM_02_1"
msgstr "Phù… Xong rồi chứ?"

msgid "STORY_CH01_GOLEM_02_2"
msgstr "Chưa. Nhìn lò kìa."

msgid "STORY_CH01_GOLEM_03_1"
msgstr "Lò Mẹ vẫn lạnh…"

msgid "STORY_CH01_GOLEM_03_2"
msgstr "Thủ vệ không hút lửa. Nó chỉ đứng chắn cửa lò."

msgid "STORY_CH01_GOLEM_04_1"
msgstr "Nó không ác. Có kẻ sai nó tới chặn bọn mình."

msgid "STORY_CH01_GOLEM_05_1"
msgstr "Cái gì đây? Trông giống vòng sáng của Neo ghê."

msgid "STORY_CH01_GOLEM_06_1"
msgstr "Mảnh ấn kênh… định dạng trùng với tôi. Nguồn lệnh: 00."

msgid "STORY_CH01_GOLEM_06_2"
msgstr "Neo của chúng ta đâu phải số 00."

msgid "STORY_CH01_GOLEM_07_1"
msgstr "Vậy kẻ thật sự dập lửa vẫn còn trong thung lũng."

msgid "STORY_CH01_GOLEM_08_1"
msgstr "Thủ vệ chỉ để câu giờ. Báo với Quản lý: lò sẽ tắt đúng hẹn."

msgid "STORY_CH01_GOLEM_09_1"
msgstr "Trên kia! Có người!"

msgid "STORY_CH01_GOLEM_10_1"
msgstr "Đuổi theo. Phải tìm ra hắn trước khi Lò Mẹ tắt hẳn."

msgid "STORY_CH01_GOLEM_10_2"
msgstr "Đã ghi dấu kênh lạ. Chờ lệnh của Quản lý."

msgid "STORY_CH01_GOLEM_CARD_TITLE"
msgstr "Ải 1-1 — Hoàn thành"

msgid "STORY_CH01_GOLEM_CARD_SUB"
msgstr "Tiếp theo: lần theo kẻ đeo mặt nạ qua Thung Lũng Tro Tàn."

msgid "STORY_CH01_END_03_2"
msgstr "Quản lý của ngươi là ai?"

msgid "BOSS_HENCHMAN_01"
msgstr "Kẻ Đeo Mặt Nạ"

msgid "STAGE_01_05_NAME"
msgstr "Rừng Cây Chết"

msgid "STAGE_01_05_DESC"
msgstr "Dấu chân tay sai dẫn lên rừng cây chết trên sườn vách. Hắn cắm cọc ấn khắp rừng để gọi Cặn chặn đường. Dọn đàn Cặn và lần tiếp dấu hắn."

msgid "BARK_CH01_5_START"
msgstr "Tín hiệu 00 yếu, lặp lại đều. Như có thứ gì cắm khắp khu rừng."

msgid "BARK_CH01_5_WAVE1"
msgstr "Cây chết hết rồi, đến lá khô cũng không xào xạc."

msgid "BARK_CH01_5_WAVE1_NEO"
msgstr "Cặn tro bị tín hiệu lạ kéo tới."

msgid "BARK_CH01_5_CP1"
msgstr "Cọc đá này có vòng trắng đen! Hắn cắm cái này để gọi Cặn à?"

msgid "BARK_CH01_5_CP1_NEO"
msgstr "Cọc ấn mang tín hiệu 00. Nó đang gọi Cặn tới."

msgid "BARK_CH01_5_WAVE2"
msgstr "Thêm một bầy, có cả Cặn lớn."

msgid "BARK_CH01_5_CP2"
msgstr "Nhổ hết đống cọc này. Không để hắn dùng rừng làm hàng rào."

msgid "BARK_CH01_5_CP2_NEO"
msgstr "Đã ghi vị trí các cọc ấn."

msgid "BARK_CH01_5_WAVE3"
msgstr "Bầy cuối rồi! Dọn xong là thấy đường!"

msgid "BARK_CH01_5_WAVE3_NEO"
msgstr "Bầy Cặn cuối cùng quanh cọc ấn lớn."

msgid "BARK_CH01_5_CLEAR"
msgstr "Tín hiệu tắt rồi. Đi tiếp thôi, hắn chưa xa đâu."

msgid "BARK_CH01_5_CLEAR_NEO"
msgstr "Các cọc ấn đã tắt. Ra bìa rừng để hoàn tất."

msgid "STAGE_01_06_NAME"
msgstr "Cầu Đá Treo"

msgid "STAGE_01_06_DESC"
msgstr "Đường duy nhất qua vực là cây cầu đá cổ của thủ vệ, nay sụt nhiều nhịp: tay sai đã phá cầu sau lưng hắn. Nhảy qua các nhịp gãy và dọn đàn Cặn."

msgid "BARK_CH01_6_START"
msgstr "Cầu đá của thủ vệ, nhiều nhịp đã sụt. Rơi xuống thì tôi kéo về điểm neo."

msgid "BARK_CH01_6_WAVE1"
msgstr "Cầu gãy thế này thì để tớ! Nhảy là nghề của tớ."

msgid "BARK_CH01_6_WAVE1_NEO"
msgstr "Cặn tro chặn đầu cầu."

msgid "BARK_CH01_6_CP1"
msgstr "Vết chém mới trên trụ cầu. Hắn cố ý phá cho sập."

msgid "BARK_CH01_6_CP1_NEO"
msgstr "Trụ cầu có vết phá còn mới."

msgid "BARK_CH01_6_WAVE2"
msgstr "Giữa cầu không có chỗ lùi. Đánh gọn, đừng để bị đẩy xuống."

msgid "BARK_CH01_6_WAVE2_NEO"
msgstr "Giữ thăng bằng. Cặn lớn đẩy lùi rất mạnh."

msgid "BARK_CH01_6_CP2"
msgstr "Thấy đầu cầu bên kia rồi!"

msgid "BARK_CH01_6_CP2_NEO"
msgstr "Còn một đoạn cầu nữa."

msgid "BARK_CH01_6_WAVE3"
msgstr "Bầy Cặn lớn chặn đầu cầu bên kia."

msgid "BARK_CH01_6_CLEAR"
msgstr "Qua được rồi. Hắn tưởng phá cầu là cắt đuôi được bọn mình à."

msgid "BARK_CH01_6_CLEAR_NEO"
msgstr "Đã qua vực. Tiến tới đầu cầu để hoàn tất."

msgid "STAGE_01_07_NAME"
msgstr "Trạm Thủ Vệ Bỏ Hoang"

msgid "STAGE_01_07_DESC"
msgstr "Bên kia vực là trạm canh cổ của thủ vệ, khắc dấu ba vòng đá. Tay sai đã ghé đây trước. Vào trong, tìm xem hắn lấy đi thứ gì."

msgid "BARK_CH01_7_START"
msgstr "Trạm canh của thủ vệ. Dấu ba vòng đá, giống trên lưng golem."

msgid "BARK_CH01_7_WAVE1"
msgstr "Chỗ này từng có nhiều thủ vệ đứng canh. Giờ trống trơn."

msgid "BARK_CH01_7_WAVE1_NEO"
msgstr "Cặn tro làm tổ trong trạm."

msgid "BARK_CH01_7_CP1"
msgstr "Hốc tường này trống. Lõi của thủ vệ bị tháo đi rồi."

msgid "BARK_CH01_7_CP1_NEO"
msgstr "Các hốc chứa lõi thủ vệ đều trống."

msgid "BARK_CH01_7_WAVE2"
msgstr "Hắn lấy lõi thủ vệ để làm gì chứ?!"

msgid "BARK_CH01_7_WAVE2_NEO"
msgstr "Cặn lớn bám quanh hốc lõi."

msgid "BARK_CH01_7_CP2"
msgstr "Golem ở cửa lò… chắc cũng bị gắn lõi từ đây rồi sai đi."

msgid "BARK_CH01_7_CP2_NEO"
msgstr "Lõi golem ở cửa lò có thể đến từ trạm này."

msgid "BARK_CH01_7_WAVE3"
msgstr "Bầy cuối ở lối ra phía sau trạm."

msgid "BARK_CH01_7_CLEAR"
msgstr "Lấy lõi, sai thủ vệ, dập lửa. Hắn tính hết từ trước."

msgid "BARK_CH01_7_CLEAR_NEO"
msgstr "Trạm đã sạch. Ra lối sau để hoàn tất."

msgid "STAGE_01_08_NAME"
msgstr "Trại Mặt Nạ"

msgid "STAGE_01_08_DESC"
msgstr "Dấu vết dẫn tới trại tạm của tay sai trong hẻm đá. Giữa trại là cột kênh trắng đen đang hút hơi ấm của Lò Mẹ. Phá trại và tìm ra kế hoạch của hắn."

msgid "BARK_CH01_8_START"
msgstr "Cột kênh phía trước đang hút nhiệt về một mạng khác. Định dạng 00."

msgid "BARK_CH01_8_WAVE1"
msgstr "Trại của hắn! Không để sót chỗ nào."

msgid "BARK_CH01_8_WAVE1_NEO"
msgstr "Cặn tro canh quanh trại."

msgid "BARK_CH01_8_CP1"
msgstr "Bản ghi trên bàn: \"Tắt lò vào đêm nhật thực đầy nhất.\" Là đêm nay."

msgid "BARK_CH01_8_CP1_NEO"
