msgid "BARK_CH01_CP1_NEO"
msgstr "Đất sụt vì lửa ngầm đã tắt. Cẩn thận khi nhảy qua hố."

msgid "BARK_CH01_WAVE2"
msgstr "Đông hơn rồi. Đổi tớ ra, gió của tớ làm chậm được chúng."

msgid "BARK_CH01_WAVE2_NEO"
msgstr "Lần này đông hơn. Đánh từ xa hoặc làm chậm chúng sẽ dễ hơn."

msgid "BARK_CH01_CP2"
msgstr "Thấy cửa lò rồi! To hơn tớ tưởng."

msgid "BARK_CH01_CP2_NEO"
msgstr "Cửa Lò Mẹ ở ngay phía trước rồi."

msgid "BARK_CH01_CP3"
msgstr "Thủ vệ ở ngay phía trước. Đây là điểm neo cuối, cứ yên tâm."

msgid "BARK_CH01_BOSS"
msgstr "Thủ vệ! Bọn tớ ở phe Lò Mẹ mà, dừng lại!"

msgid "BARK_CH01_BOSS_NEO"
msgstr "Golem Đá Cổ! Nó không còn nghe lệnh của vùng nữa."

msgid "BARK_CH01_BOSS_B"
msgstr "Không phản hồi. Đòn đập đất của nó gồng lâu, thấy là né ngay."

msgid "BARK_CH01_PHASE2"
msgstr "Có tín hiệu kênh trong lõi thủ vệ... Không phải của tôi."

msgid "BARK_CH01_PHASE2_B"
msgstr "Có kẻ đánh thức nó sao?!"

msgid "BARK_CH01_PHASE2_B_NEO"
msgstr "Có ai đó đã cố ý đánh thức nó."

msgid "BARK_CH01_QUAKE"
msgstr "Nó đập đất tạo sóng chạy hai bên, nhảy lên mà tránh!"

msgid "BARK_CH01_QUAKE_NEO"
msgstr "Sóng đất chạy hai bên! Nhảy lên để tránh nhé."

msgid "NEO_HINT_SKILL"
msgstr "EN đã đủ! Thử Kĩ năng thường xem (%s)."

msgid "NEO_HINT_WEAPON"
msgstr "Kĩ năng vũ khí sẵn sàng (%s). Đòn này mạnh lắm đấy."

msgid "NEO_HINT_ULTIMATE"
msgstr "Thanh Tuyệt kỹ đầy rồi! Tung hết sức đi (%s)."

msgid "NEO_HINT_DODGE"
msgstr "Né (%s) ngay lúc đòn sắp trúng là né hoàn hảo, kẻ địch sẽ chậm lại."

msgid "NEO_HINT_HOLD"
